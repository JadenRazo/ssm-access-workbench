{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartOnlyWorkbenchSSHTunnel",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ec2:us-east-1:111122223333:instance/i-0123456789abcdef0",
        "arn:aws:ssm:us-east-1:111122223333:document/Workbench-SSHOnly"
      ],
      "Condition": {
        "BoolIfExists": { "ssm:SessionDocumentAccessCheck": "true" }
      }
    },
    {
      "Sid": "OpenSessionDataChannel",
      "Effect": "Allow",
      "Action": "ssmmessages:OpenDataChannel",
      "Resource": "*"
    },
    {
      "Sid": "TerminateOwnWorkbenchSessions",
      "Effect": "Allow",
      "Action": "ssm:TerminateSession",
      "Resource": "arn:aws:ssm:us-east-1:111122223333:session/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/aws:ssmmessages:session-id": "${aws:userid}",
          "ssm:resourceTag/aws:ssmmessages:target-id": "i-0123456789abcdef0"
        }
      }
    }
  ]
}
